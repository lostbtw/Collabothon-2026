# Ordo: environment variables for running the processes on your machine.
#
#   cp .env.example .env          # .env is git-ignored: put real values there, never in this file
#   uv run --env-file .env python -m backend connectors --once
#
# The code reads the environment only; nothing loads .env by itself (uv's --env-file does).
# On the cluster the same names come from the ConfigMap ordo-config and from Secrets (deploy/, role 1).
# Every value below is a default or a placeholder. Synthetic data only: no real e-mail addresses in Git.

# --- Database (all processes) --------------------------------------------------------------------
ORDO_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ordo
# Tests only: an existing Postgres for pytest (else `uv sync --group localdb` runs a private one)
# ORDO_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ordo_test

# --- Model served on the cluster (api, agents, pipeline) - role 1 / role 5 ------------------------
ORDO_LLM_BASE_URL=http://localhost:8000/v1
ORDO_LLM_MODEL=gpt-oss-20b
ORDO_LLM_API_KEY=EMPTY
ORDO_LLM_ENABLED=1
ORDO_LLM_TIMEOUT_SECONDS=60
# ORDO_LLM_CA_FILE=/path/to/service-ca.crt
# ORDO_DOCLING_URL=http://localhost:5001

# --- API (role 5) ------------------------------------------------------------------------------
# 1 = replay contracts/fixtures/event.json to every new browser stream (skeleton mode); 0 on the cluster
ORDO_SSE_REPLAY_FIXTURES=1
# Extra sender addresses mapped to People, JSON {"address": "per_..."} (e.g. the phone used in the live demo)
# ORDO_PERSON_ADDRESSES={"someone@example.test": "per_jan"}

# --- Pipeline (role 3) ----------------------------------------------------------------------------
ORDO_RAW_DIR=/data/raw
ORDO_PIPELINE_SWEEP_SECONDS=60

# --- Sandbox Bank simulator, sim/bank (role 2) ---------------------------------------------------
# Run: cd sim/bank && uvicorn bank_sim.app:app --port 8081
BANK_TOKEN=demo-token
# Role 4's Borsuk Labs statements (in Git), loaded at start into acc_pln / acc_eur / acc_owner
BANK_AUTOLOAD_DIR=../../sim/scenario/out
# The organisers' pizzeria CSV (NOT in Git: take it from the event material), loaded into acc_pizzeria
# BANK_AUTOLOAD_CSV=/path/to/pizzeria-amalfi-bank-statement-2025-v6.csv
# BANK_AUTOLOAD_ACCOUNT=acc_pizzeria
# Tests only: run the bank tests on the organisers' real file too
# BANK_TEST_CSV=/path/to/pizzeria-amalfi-bank-statement-2025-v6.csv

# --- Connectors and executor (role 2): python -m backend connectors, and the API's approve button --
# The Sandbox Bank as the app sees it; ORDO_BANK_TOKEN = the bank's BANK_TOKEN
ORDO_BANK_URL=http://localhost:8081
ORDO_BANK_TOKEN=demo-token
# NBP exchange rates (public, no key)
ORDO_NBP_URL=https://api.nbp.pl
# 1 = bank sources polled every 15 s instead of 60 s
ORDO_DEMO_MODE=0

# Invoices mailbox (IMAP). The mailbox is only read when user AND password are set.
# Gmail: turn on 2-Step Verification, then create an app password at https://myaccount.google.com/apppasswords
ORDO_IMAP_USER=
ORDO_IMAP_PASSWORD=
ORDO_IMAP_HOST=imap.gmail.com
ORDO_IMAP_PORT=993
ORDO_IMAP_FOLDER=INBOX
