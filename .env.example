# Role 2 (bank simulator, connectors, executor): variables for running them on your machine.
#
#   cp .env.example .env      # .env is git-ignored: real values go there, never in this file
#   uv run --env-file .env python -m backend connectors --once
#
# On the cluster the same names come from the ConfigMap and Secrets in deploy/.

ORDO_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ordo

# Sandbox Bank (sim/bank), and how the connectors and the approve button reach it
BANK_TOKEN=demo-token
ORDO_BANK_URL=http://localhost:8081
ORDO_BANK_TOKEN=demo-token
# The organisers' pizzeria CSV is not in Git: point the bank at your copy
# BANK_AUTOLOAD_CSV=/path/to/pizzeria-amalfi-bank-statement-2025-v6.csv

# Invoices mailbox: read only when both are set. Gmail needs an app password
# (https://myaccount.google.com/apppasswords), not the account password.
ORDO_IMAP_USER=
ORDO_IMAP_PASSWORD=
