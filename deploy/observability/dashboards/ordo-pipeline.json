    {
      "id": 5,
      "type": "stat",
      "title": "To document",
      "description": "Median seconds from a photo or PDF arriving to its Document: docling-serve OCR plus the gpt-oss-20b extraction. KSeF XML invoices skip OCR (about 5 s) and are left out, so they do not hide the slow path.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ordo-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ordo-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select percentile_cont(0.5) within group (order by extract(epoch from c.occurred_at - p.occurred_at))\nfrom outbox c join outbox p on p.id = c.causation_id\nwhere c.type = 'document.extracted' and p.type = 'raw_item.received'\n  and p.payload->>'kind' in ('email_attachment', 'upload', 'chat_photo') and $__timeFilter(c.occurred_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
