          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select o.occurred_at as \"Event time\", d.consumer as \"Consumer group\", o.type as \"Event\", d.attempts as \"Attempts\",\n  o.company_id as \"Company\", o.id as \"Event id\", o.payload::text as \"Payload\"\nfrom outbox_delivery d\njoin outbox o on o.id = d.event_id\nwhere d.status = 'dead'\norder by o.seq desc\nlimit 50"
