    {
      "id": 9,
      "type": "timeseries",
      "title": "Events per minute by type",
      "description": "How busy the pipeline is. A tall bar of raw_item.received is a connector backfill; drag across a region to zoom in.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ordo-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
