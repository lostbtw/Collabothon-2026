    {
      "id": 11,
      "type": "table",
      "title": "Receipts and invoices, newest first",
      "description": "One line per document that entered the pipeline, followed through its correlation_id: seconds from arrival to its Document, its Match and its inbox card. 'not yet': that step has not happened.",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ordo-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ordo-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select r.occurred_at as \"Received\", r.company_id as \"Company\", r.payload->>'kind' as \"Kind\",\n  d.payload->>'status' as \"Document\",\n  extract(epoch from d.occurred_at - r.occurred_at) as \"To document\",\n  extract(epoch from m.occurred_at - r.occurred_at) as \"To match\",\n  extract(epoch from rc.occurred_at - r.occurred_at) as \"To inbox card\",\n  r.correlation_id as \"Correlation id\"\nfrom outbox r\nleft join lateral (select x.* from outbox x where x.correlation_id = r.correlation_id\n                   and x.type = 'document.extracted' order by x.seq limit 1) d on true\nleft join lateral (select x.* from outbox x where x.correlation_id = r.correlation_id\n                   and x.type in ('match.suggested', 'match.decided') order by x.seq limit 1) m on true\nleft join lateral (select rec.id from recommendations rec where rec.subject_id = m.payload->>'match_id'\n                   order by rec.seq limit 1) rec on true\nleft join lateral (select x.* from outbox x where x.type = 'recommendation.created'\n                   and x.payload->>'recommendation_id' = rec.id order by x.seq limit 1) rc on true\nwhere r.type = 'raw_item.received'\n  and r.payload->>'kind' in ('email_attachment', 'upload', 'chat_photo', 'ksef_invoice_xml')\n  and $__timeFilter(r.occurred_at)\norder by r.seq desc\nlimit 50"
        }
