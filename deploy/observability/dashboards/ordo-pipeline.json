      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ordo-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select d.consumer as \"Consumer group\",\n  count(*) filter (where d.status = 'pending') as \"Waiting\",\n  count(*) filter (where d.status = 'dead') as \"Dead\",\n  count(*) filter (where d.status = 'done') as \"Done\",\n  coalesce(extract(epoch from now() - min(o.occurred_at) filter (where d.status = 'pending')), 0) as \"Oldest waiting\"\nfrom outbox_delivery d\njoin outbox o on o.id = d.event_id\nwhere d.consumer <> 'sse'\ngroup by d.consumer\norder by 2 desc, 1"
        }
      ],
      "fieldConfig": {
