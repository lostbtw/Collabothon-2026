    {
      "id": 6,
      "type": "stat",
      "title": "To inbox card",
      "description": "Median seconds from a photo or PDF arriving to its card in the owner's inbox: the live-demo chain, target under 30 s. The last hop joins through recommendations.subject_id, because recommendation.created carries no correlation_id.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ordo-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ordo-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select percentile_cont(0.5) within group (order by extract(epoch from rc.occurred_at - raw.occurred_at))\n  from outbox m\n  join outbox raw on raw.type = 'raw_item.received' and raw.correlation_id = m.correlation_id\n  join recommendations r on r.subject_id = m.payload->>'match_id'\n  join outbox rc on rc.type = 'recommendation.created' and rc.payload->>'recommendation_id' = r.id\n  where m.type = 'match.suggested' and raw.payload->>'kind' in ('email_attachment', 'upload', 'chat_photo')\n    and $__timeFilter(rc.occurred_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 7,
      "type": "nodeGraph",
      "title": "Data flow in the time range",
      "description": "Processes and the events between them. Circle: a process; inside, what waits for it (all time) or, for a process that only sends, how many events it sent. Arrow: events from one process to another in the time range; hover it for the event types. Green: fine; orange: something waits over 2 min; red: dead deliveries. 'ui' is the browser, which gets events no worker reads (toasts, inbox badge). Use the + and - buttons to zoom, drag to move.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 13,
        "h": 15
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ordo-postgres"
      },
      "targets": [
        {
          "refId": "nodes",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ordo-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with ev as (\n  select o.id, o.type, o.occurred_at,\n    case\n      when o.producer in ('connector', 'connector-mail') then 'connectors'\n      when o.producer = 'finance-engine' then 'finance'\n      when o.producer = 'pipeline' and o.type in ('transaction.ingested', 'document.extracted') then 'normaliser'\n      when o.producer = 'pipeline' then 'matcher'\n      else o.producer\n    end as source\n  from outbox o\n  where $__timeFilter(o.occurred_at)\n),\nflows as (\n  -- one row per (event, consumer group); events no worker subscribes to only reach the browser\n  select ev.id, ev.type, ev.occurred_at, ev.source, coalesce(s.consumer, 'ui') as target, d.status\n  from ev\n  left join outbox_subscription s on s.event_type = ev.type\n  left join outbox_delivery d on d.event_id = ev.id and d.consumer = s.consumer\n),\nnames as (select source as id from flows union select target from flows),\nproduced as (select source as id, count(distinct id) as n from flows group by source),\nbacklog as (\n  -- all time, not only the time range: a waiting delivery matters however old it is\n  select d.consumer as id,\n    count(*) filter (where d.status = 'pending') as waiting,\n    count(*) filter (where d.status = 'dead') as dead,\n    extract(epoch from now() - min(o.occurred_at) filter (where d.status = 'pending')) as oldest\n  from outbox_delivery d join outbox o on o.id = d.event_id\n  where d.consumer <> 'sse'\n  group by d.consumer\n)\nselect n.id, n.id as title,\n  case n.id\n    when 'connectors' then 'ordo-connectors'\n    when 'extractor' then 'ordo-extractor'\n    when 'normaliser' then 'ordo-pipeline'\n    when 'matcher' then 'ordo-pipeline'\n    when 'agents' then 'ordo-agents'\n    when 'api' then 'ordo-api'\n    when 'executor' then 'ordo-api'\n    when 'finance' then 'backend/finance'\n    when 'ui' then 'browser, over SSE'\n    else ''\n  end as subtitle,\n  case when b.id is null then coalesce(p.n, 0) || ' sent' else b.waiting || ' waiting' end as mainstat,\n  case when b.id is null then '' else b.dead || ' dead' end as secondarystat,\n  case\n    when coalesce(b.dead, 0) > 0 then 'red'\n    when coalesce(b.oldest, 0) > 120 then 'orange'\n    else '#73bf69'\n  end as color\nfrom names n\nleft join produced p on p.id = n.id\nleft join backlog b on b.id = n.id"
        },
        {
          "refId": "edges",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ordo-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with ev as (\n  select o.id, o.type, o.occurred_at,\n    case\n      when o.producer in ('connector', 'connector-mail') then 'connectors'\n      when o.producer = 'finance-engine' then 'finance'\n      when o.producer = 'pipeline' and o.type in ('transaction.ingested', 'document.extracted') then 'normaliser'\n      when o.producer = 'pipeline' then 'matcher'\n      else o.producer\n    end as source\n  from outbox o\n  where $__timeFilter(o.occurred_at)\n),\nflows as (\n  -- one row per (event, consumer group); events no worker subscribes to only reach the browser\n  select ev.id, ev.type, ev.occurred_at, ev.source, coalesce(s.consumer, 'ui') as target, d.status\n  from ev\n  left join outbox_subscription s on s.event_type = ev.type\n  left join outbox_delivery d on d.event_id = ev.id and d.consumer = s.consumer\n)\nselect source || '->' || target as id, source, target,\n  count(*) || ' events' as mainstat,\n  count(*) filter (where status = 'pending') || ' waiting, '\n    || count(*) filter (where status = 'dead') || ' dead' as secondarystat,\n  string_agg(distinct type, ', ') as detail__types,\n  least(1 + ln(count(*)::float8), 8) as thickness,\n  case\n    when count(*) filter (where status = 'dead') > 0 then 'red'\n    when count(*) filter (where status = 'pending' and occurred_at < now() - interval '2 minutes') > 0 then 'orange'\n    else '#73bf69'\n  end as color\nfrom flows\ngroup by source, target\norder by source, target"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mainstat"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "count"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "secondarystat"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "dead or waiting"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "color"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "green ok · orange waits > 2 min · red dead"
              }
            ]
          }
        ]
      },
      "options": {
        "nodes": {},
        "edges": {}
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Queues per consumer group",
      "description": "outbox_delivery by consumer group, all time. 'sse' is left out: the browser stream reads by sequence and never marks its rows done.",
      "gridPos": {
        "x": 13,
        "y": 4,
        "w": 11,
        "h": 15
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
