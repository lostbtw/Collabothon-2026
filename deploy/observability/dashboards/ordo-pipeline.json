    {
      "id": 10,
      "type": "timeseries",
      "title": "Time per stage (average)",
      "description": "Seconds between an event and the event that caused it, averaged per minute. The slowest step is at the top of the legend. Event times have whole-second precision.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ordo-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ordo-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select $__timeGroupAlias(c.occurred_at, $__interval), p.type || ' → ' || c.type as metric,\n  avg(extract(epoch from c.occurred_at - p.occurred_at)) as value\nfrom outbox c\njoin outbox p on p.id = c.causation_id\nwhere $__timeFilter(c.occurred_at)\ngroup by 1, 2\nunion all\nselect $__timeGroupAlias(rc.occurred_at, $__interval), 'match.suggested → recommendation.created' as metric,\n  avg(extract(epoch from rc.occurred_at - m.occurred_at)) as value\n\n  from outbox m\n  join recommendations r on r.subject_id = m.payload->>'match_id'\n  join outbox rc on rc.type = 'recommendation.created' and rc.payload->>'recommendation_id' = r.id\n  where m.type = 'match.suggested' and $__timeFilter(rc.occurred_at)\ngroup by 1\norder by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
