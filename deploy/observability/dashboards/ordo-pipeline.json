    {
      "id": 12,
      "type": "table",
      "title": "Connectors: last sync per source",
      "description": "Is each source still being read? Last run age should stay below a few poll intervals.",
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ordo-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ordo-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select s.connector as \"Connector\", s.company_id as \"Company\", s.doc->>'display_name' as \"Source\",\n  last.doc->>'status' as \"Last run\", (last.doc->>'items_new')::int as \"New items\",\n  extract(epoch from now() - last.started_at::timestamptz) as \"Last run age\",\n  (select count(*) from sync_runs f where f.source_id = s.id and f.doc->>'status' <> 'success'\n     and $__timeFilter(f.started_at::timestamptz)) as \"Failed runs\",\n  coalesce(last.doc->>'error', '') as \"Error\"\nfrom sources s\nleft join lateral (select r.* from sync_runs r where r.source_id = s.id order by r.seq desc limit 1) last on true\norder by 1, 2"
        }
