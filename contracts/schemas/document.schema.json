{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordo.sample/contracts/schemas/document.schema.json",
  "title": "Document",
  "type": "object",
  "required": [
    "id",
    "company_id",
    "raw_item_ids",
    "doc_type",
    "direction",
    "channel",
    "seller",
    "buyer",
    "totals",
    "extraction",
    "status",
    "flags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Opaque id, prefix 'doc_'",
      "pattern": "^doc_[A-Za-z0-9_]+$"
    },
    "company_id": {
      "type": "string",
      "description": "Opaque id, prefix 'co_'",
      "pattern": "^co_[A-Za-z0-9_]+$"
    },
    "raw_item_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Opaque id, prefix 'raw_'",
        "pattern": "^raw_[A-Za-z0-9_]+$"
      },
      "minItems": 1
    },
    "duplicate_of": {
      "oneOf": [
        {
          "type": "string",
          "description": "Opaque id, prefix 'doc_'",
          "pattern": "^doc_[A-Za-z0-9_]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "invoice",
        "simplified_invoice",
        "receipt",
        "proforma",
        "credit_note",
        "other"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "purchase",
        "sale"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "ksef",
        "email",
        "photo",
        "accounting_api",
        "upload"
      ]
    },
    "number": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "issue_date": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "sale_date": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "due_date": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "seller": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "counterparty_id": {
          "oneOf": [
            {
              "type": "string",
              "description": "Opaque id, prefix 'cp_'",
              "pattern": "^cp_[A-Za-z0-9_]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "tax_id": {
          "oneOf": [
            {
              "type": "string",
              "description": "NIP / VAT id / USt-IdNr as printed"
            },
            {
              "type": "null"
            }
          ]
        },
        "country": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "address": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "buyer": {
      "type": "object",
      "required": [
        "name",
        "is_company"
      ],
      "properties": {
        "counterparty_id": {
          "oneOf": [
            {
              "type": "string",
              "description": "Opaque id, prefix 'cp_'",
              "pattern": "^cp_[A-Za-z0-9_]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "tax_id": {
          "oneOf": [
            {
              "type": "string",
              "description": "NIP / VAT id / USt-IdNr as printed"
            },
            {
              "type": "null"
            }
          ]
        },
        "country": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "address": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_company": {
          "type": "boolean",
          "description": "true when buyer tax id equals the company's tax id"
        }
      },
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "required": [
        "gross"
      ],
      "properties": {
        "net": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "vat": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "gross": {
          "$ref": "common.schema.json#/$defs/Money"
        },
        "gross_base": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "fx": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/FxConversion"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "vat_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rate",
          "net",
          "vat"
        ],
        "properties": {
          "rate": {
            "type": "string",
            "description": "'23', '8', '5', '0', 'zw', 'np', 'oo'"
          },
          "net": {
            "type": "string"
          },
          "vat": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit_price": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "net": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "vat_rate": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "payment": {
      "type": "object",
      "required": [],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "card",
            "transfer",
            "cash",
            "direct_debit",
            "unknown"
          ]
        },
        "card_last4": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "paid": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "paid_date": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "bank_account": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "submitted_by": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/PersonRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "extraction": {
      "type": "object",
      "required": [
        "method",
        "confidence"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "xml_parse",
            "api",
            "llm_vision",
            "docling_llm",
            "manual"
          ]
        },
        "model": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0..1"
        },
        "field_confidence": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "0..1"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trace_id": {
          "oneOf": [
            {
              "type": "string",
              "description": "MLflow trace id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "category_suggestion": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "category",
            "confidence"
          ],
          "properties": {
            "category": {
              "$ref": "common.schema.json#/$defs/Category"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "0..1"
            },
            "method": {
              "type": "string",
              "enum": [
                "rule",
                "history",
                "llm"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "extracted",
        "needs_review",
        "approved",
        "rejected",
        "duplicate"
      ]
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "buyer_not_company",
          "vat_not_deductible",
          "possible_private",
          "missing_tax_id",
          "duplicate_suspected",
          "amount_unclear",
          "foreign_currency",
          "reverse_charge",
          "low_confidence"
        ]
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "description": "A financial document after extraction: purchase invoice, receipt, sales invoice. One per real-world document copy; duplicates point to the golden record."
}